# ==============================================================================
# Lyftr AI Chat - Environment Configuration
# Copy this file to .env and replace placeholder values with real credentials.
# NEVER commit your .env file or real API keys to version control.
# ==============================================================================

# --- Backend: LLM & Key Pool ---
# Comma-separated list of API keys for the configured LiteLLM model/provider.
# At least TWO keys are required for automatic failover demonstration.
# Keys are referenced internally as key_1, key_2, ... (never exposed in responses).
LLM_API_KEYS=your-api-key-1,your-api-key-2

# LiteLLM model identifier (examples: gemini/gemini-2.0-flash, openai/gpt-4o-mini, groq/llama-3.1-8b-instant)
LLM_MODEL=gemini/gemini-2.0-flash

# Optional default system prompt applied when a request omits system_prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise, and accurate AI assistant.

# Per-request LLM call timeout in seconds
LLM_TIMEOUT_SECONDS=30

# --- Backend: LiteLLM Cache ---
# Enable LiteLLM built-in response caching (true/false)
CACHE_ENABLED=true
# Cache backend: "local" (in-memory) or "disk"
LITELLM_CACHE_TYPE=local

# --- Backend: Database (SQLite ONLY) ---
# Docker production path: sqlite:////data/app.db
# Local non-Docker path: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# --- Backend: CORS & Failure Simulation ---
# Comma-separated list of allowed frontend origins (do not use * with credentials)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Enable X-Simulate-Failure test header on POST /chat (true/false)
ENABLE_FAILURE_SIMULATION=true

# --- Frontend ---
# Public/local base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:8000
